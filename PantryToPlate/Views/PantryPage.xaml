<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PantryToPlate.Core.ViewModels;assembly=PantryToPlate.Core"
             x:Class="PantryToPlate.Views.PantryPage"
             Title="Pantry">



    <ContentPage.Content>
        <Grid RowDefinitions="Auto, Auto, *" Padding="16" RowSpacing="15">
            <Label Text="My Pantry"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Grid.Row="0" />

            <Frame CornerRadius="10" Padding="15" BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray600}}" Grid.Row="1">
                <StackLayout Spacing="10">
                    <Label Text="Add Ingredient" FontSize="18" FontAttributes="Bold" />

                    <Entry Placeholder="Ingredient name"
                            Text="{Binding NewIngredientName}" />

                    <Entry Placeholder="Quantity"
                            Text="{Binding NewQuantity}"
                            Keyboard="Numeric" />

                    <Entry Placeholder="Unit (e.g., cups, lbs, oz)"
                            Text="{Binding NewUnit}" />

                    <Button Text="Add to Pantry"
                            Command="{Binding AddPantryItemCommand}"
                            Style="{StaticResource BaseButton}" />

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{AppThemeBinding Light={StaticResource Red}, Dark={StaticResource Magenta}}"
                           FontSize="12"
                           HorizontalOptions="Center"
                           IsVisible="{Binding HasError}" />
                </StackLayout>
            </Frame>

            <CollectionView ItemsSource="{Binding PantryItems}" Grid.Row="2">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource BaseCard}">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="10" Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="{Binding Ingredient.Name}"
                                           FontSize="16"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding QuantityInStock}"
                                           FontSize="16" />
                                    <Label Text="{Binding Unit}"
                                           FontSize="16" />
                                </HorizontalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Delete"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PantryViewModel}}, Path=DeletePantryItemCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Red}, Dark={StaticResource Magenta}}"
                                        TextColor="White"
                                        FontSize="12"
                                        Padding="10,5"
                                        CornerRadius="5"
                                        HeightRequest="35"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="No items in pantry yet!"
                   IsVisible="{Binding PantryItems, Converter={StaticResource InverseBoolConverter}}"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                   Grid.Row="2"
                   VerticalOptions="Center" />
        </Grid>
    </ContentPage.Content>

</ContentPage>