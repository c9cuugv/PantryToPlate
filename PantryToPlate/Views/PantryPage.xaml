<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PantryToPlate.Core.ViewModels;assembly=PantryToPlate.Core"
             x:Class="PantryToPlate.Views.PantryPage"
             Title="Pantry">



    <ContentPage.Content>
        <StackLayout Padding="16" Spacing="15">
            <Label Text="My Pantry"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Frame CornerRadius="10" Padding="15" BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray600}}">
                <StackLayout Spacing="10">
                    <Label Text="Add Ingredient" FontSize="18" FontAttributes="Bold" />

                    <Entry Placeholder="Ingredient name"
                            Text="{Binding NewIngredientName}" />

                    <Entry Placeholder="Quantity"
                            Text="{Binding NewQuantity}"
                            Keyboard="Numeric" />

                    <Entry Placeholder="Unit (e.g., cups, lbs, oz)"
                            Text="{Binding NewUnit}" />

                    <Button Text="Add to Pantry"
                            Command="{Binding AddPantryItemCommand}"
                            Style="{StaticResource BaseButton}" />

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{AppThemeBinding Light={StaticResource Red}, Dark={StaticResource Magenta}}"
                           FontSize="12"
                           HorizontalOptions="Center"
                           IsVisible="{Binding HasError}" />
                </StackLayout>
            </Frame>

            <CollectionView ItemsSource="{Binding PantryItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.LeftItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem Text="Delete"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource Red}, Dark={StaticResource Magenta}}"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PantryViewModel}}, Path=DeletePantryItemCommand}"
                                             CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.LeftItems>

                            <Frame Style="{StaticResource BaseCard}">
                                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                    <Label Text="{Binding Ingredient.Name}"
                                           FontSize="16"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding QuantityInStock}"
                                           FontSize="16" />
                                    <Label Text="{Binding Unit}"
                                           FontSize="16" />
                                </HorizontalStackLayout>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="No items in pantry yet!"
                   IsVisible="{Binding PantryItems, Converter={StaticResource InverseBoolConverter}}"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
        </StackLayout>
    </ContentPage.Content>

</ContentPage>