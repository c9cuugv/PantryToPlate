<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PantryToPlate.Core.ViewModels;assembly=PantryToPlate.Core"
             x:Class="PantryToPlate.Views.ShoppingListPage"
             Title="Shopping List">



    <ContentPage.Content>
        <StackLayout Padding="16" Spacing="15">
            <Label Text="Shopping List"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Button Text="Load Shopping List"
                    Command="{Binding LoadShoppingListItemsCommand}"
                    Style="{StaticResource BaseButton}" />

            <CollectionView ItemsSource="{Binding ShoppingListItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource BaseCard}">
                            <HorizontalStackLayout VerticalOptions="Center" Spacing="12">
                                <CheckBox IsChecked="{Binding IsPurchased, Mode=TwoWay}"
                                          CheckedChanged="OnPurchasedToggled" />
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Ingredient.Name}"
                                           FontSize="16"
                                           TextDecorations="{Binding IsPurchased, Converter={StaticResource BoolToStrikethroughConverter}}" />
                                    <Label Text="{Binding PurchaseAmountText}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                           TextDecorations="{Binding IsPurchased, Converter={StaticResource BoolToStrikethroughConverter}}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <Button Text="Clear Purchased"
                        Grid.Column="0"
                        Command="{Binding ClearPurchasedCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Red}, Dark={StaticResource Magenta}}"
                        TextColor="White" />
                <Button Text="Put Back to Pantry"
                        Grid.Column="1"
                        Command="{Binding RestockToPantryCommand}"
                        Style="{StaticResource BaseButton}" />
            </Grid>

            <Label Text="No shopping items found. Add recipes or ingredients to generate your list."
                   IsVisible="{Binding ShoppingListItems, Converter={StaticResource InverseBoolConverter}}"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
        </StackLayout>
    </ContentPage.Content>

</ContentPage>
