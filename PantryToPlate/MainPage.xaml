<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PantryToPlate.Core.ViewModels;assembly=PantryToPlate.Core"
             x:Class="PantryToPlate.MainPage"
             Title="Home">



    <ContentPage.Content>
        <StackLayout Padding="16" Spacing="10">
            <Label Text="Recipes"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Load Recipes"
                        Command="{Binding LoadRecipesCommand}"
                        Style="{StaticResource BaseButton}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />
                <Button Text="Add Recipe"
                        Command="{Binding CreateRecipeCommand}"
                        Style="{StaticResource BaseButton}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}" />

            <CollectionView ItemsSource="{Binding Recipes}"
                           SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource BaseCard}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.NavigateToRecipeCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                      CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <StackLayout>
                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,5">
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           Grid.Column="0"
                                           VerticalOptions="Center" />
                                    <Frame BackgroundColor="#2E7D32" 
                                           CornerRadius="4" 
                                           Padding="6,2" 
                                           HasShadow="False"
                                           BorderColor="Transparent"
                                           IsVisible="{Binding CanMake}"
                                           Grid.Column="1"
                                           VerticalOptions="Center">
                                        <Label Text="Pantry Ready" 
                                               TextColor="White" 
                                               FontSize="10" 
                                               FontAttributes="Bold" />
                                    </Frame>
                                </Grid>
                                <Label Text="{Binding RequiredIngredients, Converter={StaticResource IngredientsToSummaryConverter}}"
                                        FontSize="14"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="No recipes added yet. Tap 'Add Recipe' to create a new one!"
                   IsVisible="{Binding HasRecipes, Converter={StaticResource InverseBoolConverter}}"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
        </StackLayout>
    </ContentPage.Content>

</ContentPage>
